<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Night Reign Dashboard</title>
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body>
    <nav class="navbar">
      <ul>
        <li><a href="/dashboard">🏠 Dashboard</a></li>
        <li><a href="/transcripts">📜 Transcripts</a></li>
      </ul>
    </nav>

    <div class="container">
      <h1>NightReign Matchmaking Bot Dashboard</h1>
      <p class="welcome-msg">Welcome, <strong><%= user.username %></strong>!</p>

      <div class="status-box">
        <img src="<%= botAvatar %>" alt="Bot Avatar" class="bot-avatar" />

        <div class="status-text">
          <h2><%= botName %></h2>
          <p class="status-indicator">🟢 Online</p>
          <div class="status-grid">
            <div>
              <strong>Uptime:</strong> <%= Math.floor(botStatus.uptime / 60) %>
              mins
            </div>
            <div><strong>Servers:</strong> <%= botStatus.serverCount %></div>
            <div><strong>Users:</strong> <%= botStatus.userCount %></div>
          </div>
        </div>
      </div>

      <div class="controls">
        <button class="control-btn restart-btn" onclick="restart()">
          🔄 Restart Bot
        </button>
        <button class="control-btn backup-btn" onclick="backupDatabase()">
          📂 Backup Database
        </button>
      </div>

      <h2>📜 Recent Transcripts</h2>
      <table>
        <tr>
          <th>ID</th>
          <th>Opened By</th>
          <th>Closed By</th>
          <th>Closed At</th>
          <th>View</th>
        </tr>
        <% transcripts.forEach(t => { %>
        <tr>
          <td><%= t.id %></td>
          <td><%= t.username %></td>
          <td><%= t.closed_by_username %></td>
          <td><%= new Date(t.closed_at).toLocaleString() %></td>
          <td>
            <a class="transcript-view" href="/transcripts/<%= t.id %>"
              >🔎 View</a
            >
          </td>
        </tr>
        <% }) %>
      </table>
    </div>

    <script>
      async function restart() {
        const res = await fetch("/restart", { method: "POST" });
        alert(res.ok ? "✅ Restarting..." : "❌ Failed to restart.");
      }

      async function backupDatabase() {
        const res = await fetch("/backup", { method: "POST" });
        alert(res.ok ? "✅ Backup created!" : "❌ Backup failed.");
      }
    </script>
  </body>
</html>
